{
  "name": "sss_extension",
  "version": "2.2.3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "shx rm -rf dist node_modules/.vite && vite",
    "build": "shx rm -rf dist node_modules/.vite && vite build",
    "test": "react-scripts test",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ledgerhq/hw-transport-webhid": "6.27.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/crypto-js": "^4.1.0",
    "@types/jest": "^27.0.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/w3c-web-hid": "^1.0.3",
    "boring-avatars": "^1.7.0",
    "crypto-js": "^4.1.1",
    "i18next": "^25.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-icons": "^5.5.0",
    "recoil": "^0.7.5",
    "rxjs": "^7.5.2",
    "symbol-hd-wallets": "^0.14.2",
    "symbol-ledger-typescript": "^0.0.1-alpha-202106071548",
    "symbol-node-util": "^2.0.1",
    "symbol-qr-library": "^0.14.2",
    "symbol-sdk": "^2.0.4",
    "symbol-uri-scheme": "^0.6.1",
    "web-vitals": "^2.1.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.0.17",
    "@storybook/addon-onboarding": "^9.0.17",
    "@storybook/react-vite": "^9.0.17",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-storybook": "^9.0.17",
    "prettier": "^3.6.2",
    "shx": "^0.4.0",
    "storybook": "^9.0.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-svgr": "^4.3.0",
    "webpack": "^5.100.2",
    "webpack-cli": "^4.9.1"
  },
  "volta": {
    "node": "24.4.0",
    "npm": "11.4.2",
    "yarn": "4.9.2"
  }
}
